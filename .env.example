# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (PowerShell)
#
# If a `.env` file exists next to app.py at deploy time, `modal deploy app.py` reads these
# values and ships them into the containers automatically (via modal.Secret.from_dotenv()).
# No `modal secret create` needed in that case.
#
# To force named Modal secrets instead of this file, set AVATAR_SECRETS=named before deploying.
# NEVER commit the real `.env` — it's gitignored.

# --- ElevenLabs (TTS provider A + Instant Voice Clone) ---
# Needed for the ElevenLabs TTS path and for voice cloning during onboarding.
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here

# --- Fish Audio (TTS provider B — s2.1-pro) ---
# Needed when a request sets tts_provider="fishaudio" (or constants.TTS_PROVIDER_DEFAULT).
FISH_API_KEY=your_fish_audio_key_here

# --- Groq (Stage-0 audio director — openai/gpt-oss-120b) ---
# Required: constants.DIRECTOR_PROVIDER == "groq" is the default. Key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# --- Gemini / nano-banana (studio reference image generation) ---
# Optional. Requires PAID Gemini API billing — image generation is billing-gated (limit:0) on the
# free tier, so studio references are currently made by hand and registered with `set_reference`.
GEMINI_API_KEY=your_gemini_key_here

# --- POC profile store (only needed if constants.PROFILE_STORE_BACKEND == "postgres") ---
# Free tier of Supabase / Neon / PlanetScale. Leave blank if using PROFILE_STORE_BACKEND="modal_dict".
POSTGRES_CONN_STRING=postgresql://user:password@host:5432/dbname

# --- App-level bearer token (checked on top of Modal proxy-auth) ---
# Invent a long random string; callers send it as `Authorization: Bearer <this>`.
# Also doubles as the demo control-panel (frontend.py) password.
APP_BEARER_TOKEN=change_me_to_a_long_random_string

# --- Modal proxy-auth token pair (create at modal.com/settings/proxy-auth-tokens) ---
# Only needed by the control panel (frontend.py) to reach the proxy-auth-protected endpoints.
MODAL_PROXY_KEY=wk-your_token_id
MODAL_PROXY_SECRET=ws-your_token_secret

# --- Deployed endpoint URLs the control panel proxies to (from `modal deploy` output) ---
ONBOARD_URL=https://<workspace>--easywebinar-avatar-pipeline-host-onboard.modal.run
GENERATE_URL=https://<workspace>--easywebinar-avatar-pipeline-generate.modal.run
